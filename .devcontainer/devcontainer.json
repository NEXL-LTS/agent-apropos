{
  "name": "agent-apropos",
  "dockerComposeFile": "docker-compose.yml",
  "service": "app",
  "workspaceFolder": "/workspace",
  "remoteUser": "vscode",
  "initializeCommand": [
    "bash",
    "${localWorkspaceFolder}/.devcontainer/initialize.sh"
  ],
  "customizations": {
    "vscode": {
      "extensions": [
        "crystal-lang-tools.crystal-lang",
        "anthropic.claude-code"
      ],
      "settings": {
        "terminal.integrated.defaultProfile.linux": "bash"
      }
    }
  },
  "postCreateCommand": "make deps && make install && crystal --version && agent-apropos --version && .devcontainer/install_agents.sh"
}
